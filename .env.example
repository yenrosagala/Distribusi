# Copy to .env and fill in real values. Never commit the real .env.

# Password for the admin portal. Leave unset to disable admin access.
ADMIN_PASSWORD=change-me

# Optional: point at Postgres instead of the local data/app_data.db.
# Leave unset to use data/app_data.db.
#
# Supabase users: prefer the pooler host over the direct db.<ref> host — the
# direct host only resolves if your IP is allow-listed, and the pooler does not
# exhaust your project's connection quota. The `postgres.<ref>` username is
# correct for the pooler; the plain `postgres` role is for the direct host.
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
